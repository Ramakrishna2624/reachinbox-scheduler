  "version": "1.0.0",
  "description": "ReachInbox Scheduler Express + TypeScript Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/index.ts",
    "build": "prisma generate && tsc",
